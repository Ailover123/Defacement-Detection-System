# Ignore runtime data (database, snapshots)
data/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Virtual environment
venv/
.env

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/

# Logs
*.log

# Ignore local Python bytecode
*.pyc

# Local Data and Logs
logs/
baselines/
data_*.db
export_*.json
debug/

# Documentation files (sensitive/internal)
*.docx
*.doc

# Generated reports
reports/

# Sensitive credentials
*.pem
*.key
*.cert
